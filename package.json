{
	"name": "tureel",
	"version": "0.1.0",
	"private": true,
	"description": "A fast, client-only reader for the top entries of developer news sources.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "biome check",
		"format": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"ci": "biome check && tsc --noEmit && vitest run && vite build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"jsdom": "31.0.1",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
